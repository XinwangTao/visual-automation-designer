  "exits": [
    { "code": 0, "meaning": "成功（dry-run 解析成功也返回 0）" },
    { "code": 2, "meaning": "用法错误 / 流程读取或解析失败 / 校验失败" },
    { "code": 3, "meaning": "目标未找到、分数低于阈值、UIA 控件被遮挡" },
    { "code": 4, "meaning": "断言或 expect 失败" },
    { "code": 5, "meaning": "I/O、截图、COM、运行时错误" }
  ],
  "constraints": [
    "MCP 服务器 vad-mcp 只是薄包装：转调 vadctl --json，不复制业务逻辑",
    "UIA 目标必须先提窗、再重读控件矩形、再校验 WindowFromPoint；被遮挡默认拒点，只有显式 --force 才绕过",
    "--dry-run 不执行动作、不提窗、不做断言，只解析目标并输出坐标/分数",
    "任一步失败默认短路；证据目录保留成功与失败截图",
    "坐标统一为物理像素；点击坐标使用 i32，支持副屏负坐标"
  ]
}
